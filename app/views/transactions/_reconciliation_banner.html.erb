<div data-reconciliation-target="banner"
     class="hidden flex items-center justify-between rounded-xl bg-blue-50 border border-blue-200 px-4 py-2 mb-2 text-sm">
  <div class="flex items-center gap-3 text-blue-800 font-medium">
    <%= icon "check-circle", size: "sm", class: "text-blue-500" %>
    <%= t(".reconciliation.banner_title") %>
  </div>

  <div class="flex items-center gap-4">
    <label class="flex items-center gap-2 text-blue-700 cursor-pointer select-none">
      <input type="checkbox"
             class="checkbox checkbox--light"
             data-action="change->reconciliation#toggleShowReconciled"
             data-reconciliation-target="showReconciled">
      <%= t(".reconciliation.show_reconciled") %>
    </label>

    <button type="button"
            class="text-blue-500 hover:text-blue-700"
            data-action="click->reconciliation#exit"
            title="<%= t(".reconciliation.exit") %>">
      <%= icon "x", size: "sm" %>
    </button>
  </div>
</div>
