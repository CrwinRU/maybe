<%# locals: (entry:) %>

<%= styled_form_with model: entry, url: transactions_path,
      class: "space-y-4",
      data: {
        controller: "transaction-form",
        "transaction-form-autocomplete-url-value": merchant_autocomplete_transactions_path,
        "transaction-form-nature-value": entry.persisted? ? (entry.amount.negative? ? "inflow" : "outflow") : (params[:nature] || "outflow")
      } do |f| %>

  <% if entry.errors.any? %>
    <%= render "shared/form_errors", model: entry %>
  <% end %>

  <%# Вкладки типа — только визуальное переключение, знак задаётся отдельно %>
  <section>
    <%= render "shared/transaction_type_tabs", active_tab: params[:nature] == "inflow" ? "income" : "expense", account_id: params[:account_id] %>
    <%= f.hidden_field :nature, value: params[:nature] || "outflow" %>
    <%= f.hidden_field :entryable_type, value: "Transaction" %>
  </section>

  <section class="space-y-2">
    <%# Переключатель знака — независим от вкладок %>
    <div class="flex rounded-lg overflow-hidden border border-alpha-black-100">
      <button type="button"
              class="flex-1 py-1 text-sm font-medium transition-colors"
              data-nature="outflow"
              data-action="click->transaction-form#setNature"
              data-active-class="bg-red-50 text-red-600"
              data-inactive-class="text-subdued hover:bg-surface-inset">
        <%= t(".expense") %>
      </button>
      <button type="button"
              class="flex-1 py-1 text-sm font-medium transition-colors"
              data-nature="inflow"
              data-action="click->transaction-form#setNature"
              data-active-class="bg-green-50 text-green-600"
              data-inactive-class="text-subdued hover:bg-surface-inset">
        <%= t(".income") %>
      </button>
    </div>

    <%= f.text_field :name, label: t(".description"), placeholder: t(".description_placeholder"), required: true %>

    <% if entry.account_id.present? %>
      <%= f.hidden_field :account_id %>
    <% else %>
      <%= f.collection_select :account_id,
            Current.family.accounts.manual.active.alphabetically, :id, :name,
            { prompt: t(".account_prompt"), label: t(".account") },
            required: true,
            class: "form-field__input text-ellipsis",
            data: { "transaction-form-target": "accountSelect" } %>
    <% end %>

    <%# Сумма — знак управляется контроллером, пользователь вводит абсолютное значение %>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-subdued font-mono text-sm"
            data-transaction-form-target="amountSign">
        <%= (entry.persisted? && entry.amount.negative?) ? "+" : "−" %>
      </span>
      <%= f.money_field :amount,
            label: t(".amount"),
            required: true,
            class: "pl-8",
            data: { "transaction-form-target": "amountInput" } %>
    </div>

    <%# Категории — все категории семьи, не фильтруются по вкладке %>
    <%= f.fields_for :entryable do |ef| %>
      <%= ef.collection_select :category_id,
            Current.family.categories.alphabetically, :id, :name,
            { prompt: t(".category_prompt"), label: t(".category") },
            data: { "transaction-form-target": "categorySelect" } %>
    <% end %>

    <%= f.date_field :date,
          label: t(".date"),
          required: true,
          min: Entry.min_supported_date,
          max: Date.current,
          value: entry.persisted? ? entry.date : Date.current %>
  </section>

  <%# Детали %>
  <%= render DS::Disclosure.new(title: t(".details")) do %>
    <%= f.fields_for :entryable do |ef| %>
      <%= ef.select :tag_ids,
                    Current.family.tags.alphabetically.pluck(:name, :id),
                    { include_blank: t(".none"), multiple: true, label: t(".tags_label"), container_class: "h-40" } %>
    <% end %>
    <%= f.text_area :notes,
                    label: t(".note_label"),
                    placeholder: t(".note_placeholder"),
                    rows: 5,
                    data: {
                      "auto-submit-form-target": "auto",
                      "transaction-form-target": "notesInput"
                    } %>
  <% end %>

  <%# Сплит транзакции %>
  <% if entry.persisted? && entry.split? %>
    <%= render "transactions/split_form", f: f, entry: entry %>
  <% end %>

  <section>
    <%= f.submit t(".submit") %>
  </section>
<% end %>
