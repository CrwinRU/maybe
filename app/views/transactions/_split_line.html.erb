<%# locals: (sf:, entry:) %>

<div class="flex items-center gap-2"
     data-split-form-target="line"
     data-locked="<%= sf.object.locked ? 'true' : 'false' %>">

  <%= sf.hidden_field :position, data: { "split-form-target": "positionField" } %>
  <%= sf.hidden_field :locked,   data: { "split-form-target": "lockedField" } %>
  <%= sf.hidden_field :_destroy, data: { "split-form-target": "destroyField" } %>

  <%# Категория %>
  <%= sf.collection_select :category_id,
        Current.family.categories.alphabetically, :id, :name,
        { prompt: t("transactions.form.category_prompt") },
        class: "form-field__input flex-1 text-sm",
        data: { "split-form-target": "categorySelect" } %>

  <%# Сумма %>
  <div class="relative w-28 shrink-0">
    <%= sf.number_field :amount,
          step: "0.01",
          min: "0.01",
          placeholder: "0.00",
          class: "form-field__input text-sm text-right pr-2 w-full",
          data: {
            "split-form-target": "amountInput",
            action: "input->split-form#onAmountInput"
          } %>
  </div>

  <%# Замочек %>
  <button type="button"
          title="<%= t('transactions.split_form.lock') %>"
          class="shrink-0 p-1 rounded transition-colors hover:bg-surface-inset"
          data-action="click->split-form#toggleLock"
          data-split-form-target="lockButton">
    <%# Открытый замочек (по умолчанию) %>
    <svg data-split-form-target="lockOpen"
         xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="text-subdued">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
    </svg>
    <%# Закрытый замочек (когда locked=true) %>
    <svg data-split-form-target="lockClosed"
         xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="text-primary hidden">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
  </button>

  <%# Удалить строку %>
  <button type="button"
          class="shrink-0 p-1 rounded text-subdued hover:text-red-500 transition-colors"
          title="<%= t('transactions.split_form.remove') %>"
          data-action="click->split-form#removeLine">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

</div>
